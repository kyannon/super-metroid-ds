+/* Super Metroid DS, widescreen (gfx.cpp): a window's edge in the wider
+ * picture; one at a screen edge goes to the picture's edge ("stretch
+ * windowing effects") */
+extern int smds_ws_ext;
+/* the layers and sprites drawn only in the picture's columns smds_ws_l ..
+ * smds_ws_r - 1 (gfx.cpp: the room, in Super Metroid; the backdrop fills the
+ * rest) */
+extern int smds_ws_l, smds_ws_r;
+static void smds_ws_clip_layer (struct ClipData *c)
+{
+	if (smds_ws_ext <= 0 || IPPU.DoubleWidthPixels)
+		return;
+	int n = 0;
+	for (int i = 0; i < c->Count; i++)
+	{
+		int l = c->Left[i] < smds_ws_l ? smds_ws_l : c->Left[i];
+		int r = c->Right[i] > smds_ws_r ? smds_ws_r : c->Right[i];
+		if (l >= r)
+			continue;
+		c->Left[n] = l, c->Right[n] = r, c->DrawMode[n] = c->DrawMode[i];
+		n++;
+	}
+	c->Count = n;
+}
+
+/* bsnes-hd's "stretch windowing effects" (a patch's .bso, S 2): a window's
+ * edges are doubled about the middle, the game's x being 2x - 128 (a
+ * widescreen patch draws its windows that way: Super Metroid's surveillance
+ * eyes' beams); otherwise they're the game's x */
+int smds_ws_stretch = 0;
+static inline int smds_ws_x (int x)
+{
+	if (smds_ws_ext <= 0 || IPPU.DoubleWidthPixels)
+		return x;
+	int W = 256 + 2 * smds_ws_ext;
+	if (x <= 0)
+		return 0;
+	if (x >= 256)
+		return W;
+	if (smds_ws_stretch)
+	{
+		x = 2 * x - 128 + smds_ws_ext;
+		return x < 0 ? 0 : x > W ? W : x;
+	}
+	return x + smds_ws_ext;
+}
