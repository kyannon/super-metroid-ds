+/* Super Metroid DS, widescreen: smds_ws_ext more columns either side of the
+ * 256 (0: off). The picture is 256 + 2 * ext wide; the game's x is the
+ * picture's x - ext: backgrounds scroll ext further left (RenderLine),
+ * windows that reach a screen edge reach the picture's (clip.cpp), and
+ * sprites at x 256..256+ext-1 (which wrap to the left on a SNES) are drawn
+ * at the right ("unsafe", as bsnes-hd calls it). Not for hires modes. */
+int smds_ws_ext = 0;
+/* the columns the layers and sprites may use (clip.cpp), set at the start of
+ * each frame from smds_ws_room: 0 the whole picture, 1 the room (width
+ * smds_ws_room_w pixels, its left edge at the level's x 0; the camera's x is
+ * near smds_ws_camx and the same as BG1's scroll, mod 1024), 2 the middle 256 */
+int smds_ws_l = 0, smds_ws_r = 512;
+int smds_ws_room = 0, smds_ws_room_w = 256, smds_ws_camx = 0;
+static void smds_ws_frame_clip (void)
+{
+	int W = 256 + 2 * smds_ws_ext;
+	smds_ws_l = 0, smds_ws_r = W;
+	if (smds_ws_ext <= 0)
+		return;
+	if (smds_ws_room == 2)
+		smds_ws_l = smds_ws_ext, smds_ws_r = smds_ws_ext + 256;
+	else if (smds_ws_room == 1)
+	{
+		/* BG1's scroll as the frame starts, when it's the camera's (near
+		 * smds_ws_camx, the game's copy, which may be a frame on already);
+		 * not in an effect that moves BG1 (Ridley flying off in Ceres) */
+		int h = PPU.BG[0].HOffset & 0x3ff;
+		int x = smds_ws_camx + ((h - smds_ws_camx) & 0x3ff);
+		if (x - smds_ws_camx > 512)
+			x -= 1024;
+		if (x - smds_ws_camx > 32 || smds_ws_camx - x > 32)
+			x = smds_ws_camx;
+		int l = smds_ws_ext - x, r = smds_ws_ext + smds_ws_room_w - x;
+		smds_ws_l = l < 0 ? 0 : l > W ? W : l;
+		smds_ws_r = r < 0 ? 0 : r > W ? W : r;
+	}
+}
+static inline bool smds_ws(void) { return smds_ws_ext > 0 && !IPPU.DoubleWidthPixels; }
+/* a sprite's x in the picture */
+static inline int smds_ws_obj_x(int hpos) {
+	if (hpos < -256 + smds_ws_ext) hpos += 512;
+	return hpos + smds_ws_ext;
+}
